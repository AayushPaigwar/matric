	/* Cards View Grid */
	.cards-view-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 14px;
	}

	.project-card {
		background: rgba(22, 28, 41, 0.4);
		border: 1px solid var(--border-subtle);
		border-radius: 12px;
		padding: 16px;
		display: flex;
		flex-direction: column;
		gap: 12px;
		transition: border-color 0.15s ease, background 0.15s ease;
	}

	.project-card:hover {
		border-color: rgba(255, 255, 255, 0.15);
		background: rgba(26, 33, 49, 0.5);
	}

	.card-top-row {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
	}

	.project-identity {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.runtime-badge {
		width: 38px;
		height: 38px;
		border-radius: 9px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 18px;
		font-weight: bold;
	}

	.runtime-badge.nextjs { background: #000000; color: #ffffff; border: 1px solid rgba(255,255,255,0.2); }
	.runtime-badge.vite { background: linear-gradient(135deg, #41D1FF, #BD34FE); color: #ffffff; }
	.runtime-badge.python { background: #306998; color: #FFD43B; }
	.runtime-badge.postgres { background: #336791; color: #ffffff; }

	.project-naming {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.name-status-row {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.project-title {
		font-size: 15px;
		font-weight: 600;
		color: var(--text-primary);
	}

	.status-pill {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		font-size: 10px;
		font-weight: 700;
		padding: 2px 7px;
		border-radius: 10px;
	}

	.status-pill.online {
		background: rgba(16, 185, 129, 0.12);
		color: var(--accent-emerald);
		border: 1px solid rgba(16, 185, 129, 0.25);
	}

	.status-pulse-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent-emerald);
	}

	.path-branch-row {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 11.5px;
	}

	.git-branch-tag {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--accent-indigo);
		background: rgba(99, 102, 241, 0.12);
		padding: 1px 6px;
		border-radius: 4px;
	}

	.project-path-text {
		color: var(--text-muted);
		font-family: var(--font-mono);
	}

	.runtime-stats {
		display: flex;
		gap: 6px;
	}

	.stat-pill {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--text-secondary);
		background: rgba(255, 255, 255, 0.05);
		padding: 3px 7px;
		border-radius: 6px;
	}

	.card-ports-row {
		display: flex;
		align-items: center;
		gap: 8px;
		padding-top: 4px;
	}

	.port-label {
		font-size: 10px;
		font-weight: 700;
		color: var(--text-muted);
	}

	.port-chip {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		font-family: var(--font-mono);
		font-size: 11.5px;
		padding: 3px 8px;
		border-radius: 6px;
		text-decoration: none;
	}

	.port-chip.link {
		background: rgba(6, 182, 212, 0.12);
		color: var(--accent-cyan);
		border: 1px solid rgba(6, 182, 212, 0.25);
		transition: background 0.15s ease;
	}

	.port-chip.link:hover {
		background: rgba(6, 182, 212, 0.22);
	}

	.port-chip.db {
		background: rgba(255, 255, 255, 0.06);
		color: var(--text-secondary);
	}

	.port-dot {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--accent-emerald);
	}

	.port-arrow {
		font-size: 9px;
		opacity: 0.8;
	}

	.card-action-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		padding-top: 10px;
	}

	.ide-launchers {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.btn-ide {
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid var(--border-subtle);
		color: var(--text-secondary);
		padding: 4px 8px;
		border-radius: 6px;
		font-size: 11px;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.btn-ide:hover {
		background: rgba(255, 255, 255, 0.12);
		color: #ffffff;
	}

	.btn-stop-port {
		background: rgba(244, 63, 94, 0.1);
		border: 1px solid rgba(244, 63, 94, 0.2);
		color: var(--accent-rose);
		padding: 4px 10px;
		border-radius: 6px;
		font-size: 11px;
		font-weight: 600;
		cursor: pointer;
	}

	.btn-stop-port:hover {
		background: rgba(244, 63, 94, 0.2);
	}

	/* Ports Table View */
	.ports-table-container {
		background: rgba(22, 28, 41, 0.4);
		border: 1px solid var(--border-subtle);
		border-radius: 12px;
		overflow: hidden;
	}

	.ports-table {
		width: 100%;
		border-collapse: collapse;
		text-align: left;
		font-size: 12.5px;
	}

	.ports-table th {
		padding: 10px 14px;
		font-size: 10px;
		font-weight: 700;
		color: var(--text-muted);
		letter-spacing: 0.05em;
		background: rgba(0, 0, 0, 0.2);
		border-bottom: 1px solid var(--border-subtle);
	}

	.ports-table td {
		padding: 10px 14px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.04);
		color: var(--text-secondary);
	}

	.ports-table tr:hover td {
		background: rgba(255, 255, 255, 0.02);
	}

	.table-port-chip {
		font-family: var(--font-mono);
		font-weight: bold;
		color: var(--accent-cyan);
	}

	.table-status-listen {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		font-size: 10px;
		font-weight: 700;
		color: var(--accent-emerald);
	}

	.table-socket-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent-emerald);
		box-shadow: 0 0 6px var(--accent-emerald);
	}

	.table-runtime-badge {
		font-size: 11.5px;
		font-weight: 500;
	}

	.table-project-cell {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.table-proj-name {
		font-weight: 600;
		color: var(--text-primary);
	}

	.table-branch-pill {
		font-family: var(--font-mono);
		font-size: 10px;
		color: var(--accent-indigo);
		background: rgba(99, 102, 241, 0.12);
		padding: 1px 5px;
		border-radius: 4px;
	}

	.table-pid, .table-cpu, .table-ram {
		font-family: var(--font-mono);
		font-size: 11.5px;
	}

	.table-action-btns {
		display: flex;
		gap: 6px;
	}

	.table-btn-browser {
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid var(--border-subtle);
		color: var(--text-primary);
		padding: 3px 8px;
		border-radius: 5px;
		font-size: 11px;
		cursor: pointer;
	}

	.table-btn-kill {
		background: rgba(244, 63, 94, 0.1);
		border: 1px solid rgba(244, 63, 94, 0.2);
		color: var(--accent-rose);
		padding: 3px 8px;
		border-radius: 5px;
		font-size: 11px;
		cursor: pointer;
	}

	/* Window Footer */
	.window-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: 16px;
		font-size: 11.5px;
		color: var(--text-muted);
	}

	.footer-left {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.footer-dot { opacity: 0.4; }

	.live-status-indicator {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--accent-emerald);
		font-weight: 500;
	}

	.hidden {
		display: none !important;
	}

	/* Section Common Styles */
	.section-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 100px 24px;
	}

	.section-badge {
		display: inline-block;
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: var(--accent-emerald);
		background: rgba(16, 185, 129, 0.1);
		border: 1px solid rgba(16, 185, 129, 0.25);
		padding: 3px 10px;
		border-radius: 12px;
		margin-bottom: 16px;
	}

	.section-heading {
		font-size: 40px;
		font-weight: 800;
		line-height: 1.2;
		letter-spacing: -0.025em;
		margin-bottom: 16px;
	}

	.section-subtext {
		font-size: 17px;
		line-height: 1.6;
		color: var(--text-secondary);
		max-width: 720px;
		margin-bottom: 48px;
	}

	.grid-3-col {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
	}

	.feature-card {
		background: var(--bg-card);
		border: 1px solid var(--border-subtle);
		border-radius: 16px;
		padding: 28px;
		display: flex;
		flex-direction: column;
		gap: 16px;
		transition: transform 0.15s ease, border-color 0.15s ease;
	}

	.feature-card:hover {
		transform: translateY(-3px);
		border-color: rgba(255, 255, 255, 0.18);
	}

	.card-icon {
		width: 44px;
		height: 44px;
		border-radius: 12px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 20px;
	}

	.card-icon.emerald { background: rgba(16, 185, 129, 0.15); color: var(--accent-emerald); }
	.card-icon.cyan { background: rgba(6, 182, 212, 0.15); color: var(--accent-cyan); }
	.card-icon.indigo { background: rgba(99, 102, 241, 0.15); color: var(--accent-indigo); }

	.feature-card h3 {
		font-size: 18px;
		font-weight: 700;
	}

	.feature-card p {
		font-size: 14px;
		line-height: 1.6;
		color: var(--text-secondary);
	}

	.micro-mockup {
		background: rgba(0, 0, 0, 0.35);
		border: 1px solid var(--border-subtle);
		border-radius: 10px;
		padding: 12px;
		margin-top: auto;
	}

	.watchdog-mockup-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-family: var(--font-mono);
		font-size: 11px;
		margin-bottom: 8px;
	}

	.tag-port-num { color: var(--accent-cyan); font-weight: bold; }
	.tag-status-warn { color: var(--accent-amber); }

	.watchdog-actions-row {
		display: flex;
		gap: 6px;
	}

	.btn-micro-gray {
		background: rgba(255, 255, 255, 0.08);
		font-size: 10px;
		padding: 3px 7px;
		border-radius: 4px;
		color: var(--text-primary);
	}

	.btn-micro-red {
		background: rgba(244, 63, 94, 0.2);
		color: var(--accent-rose);
		font-size: 10px;
		padding: 3px 7px;
		border-radius: 4px;
		font-weight: 600;
	}

	.git-pill-display {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-family: var(--font-mono);
		font-size: 11.5px;
	}

	.branch-name { color: var(--accent-indigo); font-weight: 600; }
	.branch-copy-badge { font-size: 9.5px; color: var(--text-muted); }

	.ide-chips-row {
		display: flex;
		gap: 6px;
	}

	.ide-chip {
		font-size: 10.5px;
		background: rgba(255, 255, 255, 0.08);
		padding: 3px 8px;
		border-radius: 5px;
		color: var(--text-secondary);
	}

	/* Comparison Section */
	.comparison-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 24px;
	}

	.compare-card {
		border-radius: 16px;
		padding: 24px;
		border: 1px solid var(--border-subtle);
	}

	.compare-card.old-way {
		background: rgba(244, 63, 94, 0.03);
		border-color: rgba(244, 63, 94, 0.2);
	}

	.compare-card.matric-way {
		background: rgba(16, 185, 129, 0.03);
		border-color: rgba(16, 185, 129, 0.3);
		box-shadow: 0 0 40px rgba(16, 185, 129, 0.05);
	}

	.compare-header {
		margin-bottom: 20px;
	}

	.compare-badge {
		font-size: 10.5px;
		font-weight: 800;
		padding: 3px 8px;
		border-radius: 6px;
		display: inline-block;
		margin-bottom: 6px;
	}

	.compare-badge.red { background: rgba(244, 63, 94, 0.15); color: var(--accent-rose); }
	.compare-badge.emerald { background: rgba(16, 185, 129, 0.15); color: var(--accent-emerald); }

	.compare-subtitle {
		font-size: 13px;
		color: var(--text-muted);
		display: block;
	}

	.mock-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 10px 12px;
		border-radius: 8px;
		font-size: 12px;
		margin-bottom: 6px;
	}

	.mock-row.bad {
		background: rgba(0, 0, 0, 0.3);
		border-left: 2px solid var(--accent-rose);
		color: var(--text-secondary);
	}

	.mock-row.good.parent {
		background: rgba(16, 185, 129, 0.08);
		border: 1px solid rgba(16, 185, 129, 0.2);
		color: #ffffff;
	}

	.app-title-cell {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.helpers-count {
		font-size: 11px;
		color: var(--accent-emerald);
		background: rgba(16, 185, 129, 0.15);
		padding: 1px 6px;
		border-radius: 6px;
	}

	.child-inspector-drawer {
		margin-left: 20px;
		padding: 10px 14px;
		background: rgba(0, 0, 0, 0.3);
		border-left: 2px solid var(--accent-emerald);
		border-radius: 0 0 8px 8px;
		font-size: 11.5px;
		display: flex;
		flex-direction: column;
		gap: 8px;
		margin-bottom: 12px;
	}

	.child-row {
		display: flex;
		justify-content: space-between;
		color: var(--text-muted);
	}

	.child-actions {
		display: flex;
		gap: 8px;
		margin-top: 4px;
	}

	.btn-micro-action {
		font-size: 10px;
		background: rgba(255, 255, 255, 0.08);
		padding: 2px 7px;
		border-radius: 4px;
		color: var(--text-primary);
	}

	.btn-micro-action.red {
		background: rgba(244, 63, 94, 0.2);
		color: var(--accent-rose);
	}

	.compare-verdict {
		margin-top: 16px;
		font-size: 13px;
		line-height: 1.5;
	}

	.compare-verdict.bad { color: var(--accent-rose); }
	.compare-verdict.good { color: var(--accent-emerald); }

	/* Time Travel Section */
	.scrubber-visual-box {
		background: var(--bg-card);
		border: 1px solid var(--border-subtle);
		border-radius: 16px;
		padding: 24px;
	}

	.scrubber-top-controls {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 24px;
	}

	.scrubber-range-pills {
		display: flex;
		gap: 8px;
	}

	.range-pill {
		font-size: 12px;
		font-weight: 500;
		padding: 4px 12px;
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.05);
		color: var(--text-secondary);
		cursor: pointer;
	}

	.range-pill.active {
		background: rgba(16, 185, 129, 0.15);
		color: var(--accent-emerald);
		border: 1px solid rgba(16, 185, 129, 0.3);
	}

	.scrubber-chart-area {
		position: relative;
		height: 200px;
		border-bottom: 1px solid var(--border-subtle);
		margin-bottom: 20px;
	}

	.timeline-svg {
		width: 100%;
		height: 100%;
	}

	.scrubber-needle {
		position: absolute;
		left: 64%;
		top: 0;
		bottom: 0;
		width: 2px;
		background: #ffffff;
		box-shadow: 0 0 10px rgba(255, 255, 255, 0.8);
	}

	.needle-tooltip {
		position: absolute;
		bottom: 110%;
		left: 50%;
		transform: translateX(-50%);
		background: rgba(13, 16, 23, 0.95);
		border: 1px solid var(--border-subtle);
		padding: 8px 12px;
		border-radius: 8px;
		white-space: nowrap;
		display: flex;
		flex-direction: column;
		gap: 2px;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
	}

	.time-label { font-size: 11px; color: var(--text-muted); }
	.spike-label { font-size: 12px; font-weight: 600; color: var(--accent-amber); }

	.restored-snapshot-bar {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.restored-title {
		font-size: 10.5px;
		font-weight: 700;
		color: var(--text-muted);
		letter-spacing: 0.05em;
	}

	.restored-apps-list {
		display: flex;
		gap: 10px;
	}

	.restored-app-chip {
		display: flex;
		align-items: center;
		gap: 8px;
		background: rgba(255, 255, 255, 0.05);
		padding: 5px 10px;
		border-radius: 6px;
		font-size: 11.5px;
	}

	.chip-app-name { color: var(--text-primary); font-weight: 500; }
	.chip-app-load { color: var(--accent-amber); font-family: var(--font-mono); }

	/* Sensors Grid */
	.sensors-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
	}

	.sensor-card {
		background: var(--bg-card);
		border: 1px solid var(--border-subtle);
		border-radius: 16px;
		padding: 24px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	.sensor-header {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 12px;
	}

	.sensor-icon {
		font-size: 16px;
	}

	.sensor-name {
		font-size: 11px;
		font-weight: 700;
		color: var(--text-muted);
		letter-spacing: 0.06em;
	}

	.sensor-metric-big {
		font-size: 36px;
		font-weight: 800;
		font-family: var(--font-mono);
		margin-bottom: 8px;
	}

	.sensor-desc {
		font-size: 13.5px;
		line-height: 1.5;
		color: var(--text-secondary);
		margin-bottom: 16px;
	}

	.sensor-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: 12px;
		border-top: 1px solid var(--border-subtle);
		font-size: 10.5px;
		font-family: var(--font-mono);
		color: var(--text-muted);
	}

	/* Moments & Alerts */
	.grid-2-col {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 24px;
	}

	.card-split {
		background: var(--bg-card);
		border: 1px solid var(--border-subtle);
		border-radius: 16px;
		padding: 28px;
	}

	.card-split-icon { font-size: 28px; margin-bottom: 12px; }
	.card-split h3 { font-size: 20px; font-weight: 700; margin-bottom: 10px; }
	.card-split p { font-size: 14px; line-height: 1.6; color: var(--text-secondary); margin-bottom: 20px; }

	.card-preview-box {
		background: rgba(0, 0, 0, 0.3);
		border: 1px solid var(--border-subtle);
		border-radius: 10px;
		padding: 14px;
	}

	.moment-preview-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 12px;
	}

	.moment-title { font-weight: 600; color: var(--text-primary); }
	.moment-tag { color: var(--accent-rose); font-family: var(--font-mono); font-size: 11px; }

	.alert-preview-item {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 12px;
	}

	.alert-badge-warn {
		background: rgba(245, 158, 11, 0.15);
		color: var(--accent-amber);
		padding: 2px 6px;
		border-radius: 4px;
		font-weight: 700;
		font-size: 10px;
	}

	/* Storage Section */
	.storage-grid {
