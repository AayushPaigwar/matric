---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Global Navigation Header (Tuple Style) -->
  <header class="group/header sticky top-0 z-50 min-h-14 w-full text-sm lg:text-base bg-white/95 backdrop-blur-md border-b border-gray-100 transition-colors">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
      <!-- Logo -->
      <div class="flex items-center gap-8">
        <a class="flex items-center gap-2.5 rounded-lg py-1 font-semibold text-gray-900 transition-opacity hover:opacity-80" href="/">
          <img src="/app-icon.png" alt="Matric App Icon" class="h-8 w-8 rounded-lg shadow-sm" />
          <span class="text-xl font-bold tracking-tight">Matric</span>
          <span class="rounded-full bg-purple-50 border border-purple-200/60 px-2 py-0.5 text-xs font-semibold text-purple-700">v1.0</span>
        </a>

        <!-- Nav Links -->
        <div class="hidden items-center gap-1 md:flex">
          <a href="#screenshots" class="rounded-lg px-3 py-1.5 text-sm font-medium text-gray-600 transition hover:bg-gray-100 hover:text-gray-900">
            Screenshots
          </a>
          <a href="#features" class="rounded-lg px-3 py-1.5 text-sm font-medium text-gray-600 transition hover:bg-gray-100 hover:text-gray-900">
            Features
          </a>
          <a href="#workflow" class="rounded-lg px-3 py-1.5 text-sm font-medium text-gray-600 transition hover:bg-gray-100 hover:text-gray-900">
            Shortcuts
          </a>
          <a href="#comparison" class="rounded-lg px-3 py-1.5 text-sm font-medium text-gray-600 transition hover:bg-gray-100 hover:text-gray-900">
            Compare
          </a>
          <a href="https://github.com/pawanbhayde/matric" target="_blank" rel="noopener noreferrer" class="rounded-lg px-3 py-1.5 text-sm font-medium text-gray-600 transition hover:bg-gray-100 hover:text-gray-900">
            GitHub
          </a>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-3">
        <a 
          href="https://github.com/pawanbhayde/matric" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl bg-purple-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-purple-700 active:scale-[0.98]"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4 fill-white" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          <span>View on GitHub</span>
        </a>
      </div>
    </nav>
  </header>

  <main class="flex-1">
    <!-- Hero Section (Tuple / Linear Visual Style) -->
    <section class="relative overflow-hidden pt-10 pb-20 md:pt-14 md:pb-28 bg-gradient-to-b from-gray-50/70 via-white to-white">
      <!-- Background subtle grid pattern -->
      <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:24px_24px] opacity-60 [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>

      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <!-- Floating Announcement Pill -->
        <div class="flex justify-center">
          <a 
            href="https://github.com/pawanbhayde/matric" 
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 rounded-full border border-green-200/90 bg-green-50/90 px-3.5 py-1.5 text-xs sm:text-sm font-semibold text-green-700 shadow-sm transition hover:bg-green-100 hover:border-green-300"
          >
            <span class="flex h-2 w-2 rounded-full bg-green-500 animate-pulse"></span>
            <span>Matric is 100% Free & Open Source on GitHub</span>
            <span class="text-green-600 transition-transform group-hover:translate-x-0.5">→</span>
          </a>
        </div>

        <!-- Punchy Headline & Short Subtitle -->
        <div class="mt-6 text-center">
          <h1 class="mx-auto max-w-4xl text-4xl font-bold tracking-tight !leading-[1.12] text-gray-900 sm:text-5xl md:text-6xl lg:text-7xl">
            The macOS Activity Monitor <br class="hidden sm:inline" />
            <span class="text-purple-600">built for developers.</span>
          </h1>

          <p class="mx-auto mt-4 max-w-2xl text-base sm:text-lg text-gray-600">
            Live developer port monitoring (:3000, :8000), 1-click conflict kill, dev cache cleanup, and Apple Silicon telemetry. Written in pure native Swift with &lt; 20 MB RAM.
          </p>

          <!-- CTA Buttons -->
          <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a 
              href="https://github.com/pawanbhayde/matric" 
              target="_blank"
              rel="noopener noreferrer"
              class="flex w-full items-center justify-center gap-3 rounded-xl bg-purple-600 px-7 py-3.5 text-sm sm:text-base font-semibold text-white shadow-lg shadow-purple-600/25 transition hover:bg-purple-700 hover:shadow-purple-600/35 active:scale-[0.98] sm:w-auto"
            >
              <svg class="h-5 w-5 fill-white" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
              <span>View on GitHub</span>
              <span class="rounded-md bg-purple-700/60 px-2 py-0.5 text-xs font-normal">Free & Open Source</span>
            </a>

            <a 
              href="https://github.com/pawanbhayde/matric#readme" 
              target="_blank"
              rel="noopener noreferrer"
              class="flex w-full items-center justify-center gap-2 rounded-xl border border-gray-200 bg-white px-6 py-3.5 text-sm sm:text-base font-medium text-gray-700 shadow-sm transition hover:border-gray-300 hover:bg-gray-50 active:scale-[0.98] sm:w-auto"
            >
              <span>Explore Documentation</span>
              <span class="text-gray-400">→</span>
            </a>
          </div>

          <!-- Minimal Trust Badges -->
          <div class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs font-medium text-gray-500">
            <span class="flex items-center gap-1.5">
              <svg class="h-4 w-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
              100% Free (MIT License)
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="h-4 w-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
              Native Swift · Zero Electron
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="h-4 w-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
              Air-Gapped & 100% Private
            </span>
          </div>
        </div>

        <!-- Interactive Real App Screenshot Showcase -->
        <div id="screenshots" class="relative mt-12 sm:mt-16">
          <!-- Background Glow -->
          <div class="absolute -top-12 left-1/2 -z-10 h-72 w-3/4 -translate-x-1/2 rounded-full bg-purple-200/40 blur-3xl"></div>

          <!-- macOS Window Container with Real Screenshots -->
          <div class="overflow-hidden rounded-2xl border border-gray-200/90 bg-gray-900 shadow-[0_25px_70px_-15px_rgba(0,0,0,0.18),0_0_0_1px_rgba(0,0,0,0.06)]">
            <!-- Window Titlebar with Interactive Tabs -->
            <div class="flex flex-wrap items-center justify-between border-b border-gray-800 bg-gray-950/90 px-4 py-3 backdrop-blur-md gap-3">
              <!-- Traffic lights -->
              <div class="flex items-center gap-3">
                <div class="flex gap-1.5">
                  <div class="h-3 w-3 rounded-full bg-[#ff5f57] border border-[#e0443e]"></div>
                  <div class="h-3 w-3 rounded-full bg-[#febc2e] border border-[#d89e24]"></div>
                  <div class="h-3 w-3 rounded-full bg-[#28c840] border border-[#1aab29]"></div>
                </div>
                <span class="text-xs font-semibold text-gray-300">Matric macOS App</span>
              </div>

              <!-- Interactive Screen Tabs -->
              <div class="flex items-center gap-1 rounded-xl bg-gray-900 p-1 text-xs font-medium">
                <button 
                  data-shot="/screenshots/hero-projects.png"
                  data-label="Developer Projects & Listening Ports"
                  class="shot-tab flex items-center gap-1.5 rounded-lg bg-purple-600 px-3 py-1 font-semibold text-white shadow-sm transition"
                >
                  <span>⚡ Developer Projects</span>
                </button>
                <button 
                  data-shot="/screenshots/hero-overview.png"
                  data-label="Real-Time Apple Silicon Telemetry"
                  class="shot-tab flex items-center gap-1.5 rounded-lg px-3 py-1 text-gray-400 hover:text-white transition"
                >
                  <span>📊 System Overview</span>
                </button>
                <button 
                  data-shot="/screenshots/cleanup.png"
                  data-label="Build Artifacts & Dev Cache Cleanup"
                  class="shot-tab flex items-center gap-1.5 rounded-lg px-3 py-1 text-gray-400 hover:text-white transition"
                >
                  <span>🧹 System Cleanup</span>
                </button>
                <button 
                  data-shot="/screenshots/processor.png"
                  data-label="Apple M4 10-Core Multi-Thread Load"
                  class="shot-tab hidden sm:flex items-center gap-1.5 rounded-lg px-3 py-1 text-gray-400 hover:text-white transition"
                >
                  <span>⚡ 10-Core CPU</span>
                </button>
              </div>

              <!-- View Live Indicator -->
              <div class="hidden md:flex items-center gap-2 text-[11px] font-mono text-gray-400">
                <span class="h-2 w-2 rounded-full bg-green-500 animate-pulse"></span>
                <span id="currentShotLabel">Developer Projects & Listening Ports</span>
              </div>
            </div>

            <!-- Crisp Retina Image Display Frame -->
            <div class="relative bg-black flex items-center justify-center p-1 sm:p-2">
              <img 
                id="mainScreenshot" 
                src="/screenshots/hero-projects.png" 
                alt="Matric Developer Projects View Screenshot"
                class="w-full h-auto rounded-lg shadow-2xl transition-opacity duration-300"
                loading="eager"
              />
            </div>

            <!-- Interactive Caption Bar -->
            <div class="flex flex-col sm:flex-row items-center justify-between border-t border-gray-800 bg-gray-950 px-4 py-2.5 text-xs text-gray-400 gap-2 font-mono">
              <div class="flex items-center gap-2">
                <span class="text-purple-400 font-semibold">Live Capture:</span>
                <span>Active dev servers, listening sockets (:3000, :8000), Git branch context</span>
              </div>
              <div class="flex items-center gap-3 text-[11px] text-gray-500">
                <span>Native Swift 6.0</span>
                <span>·</span>
                <span>Apple Silicon M1-M4 Optimized</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Visual 4-Pillar Feature Showcase (Real Screenshots with FULL Height, Uncropped) -->
    <section id="features" class="py-20 sm:py-28 bg-white border-t border-gray-100">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="text-center max-w-2xl mx-auto">
          <h2 class="font-mono text-xs font-semibold uppercase tracking-widest text-purple-600 sm:text-sm">
            Core Capabilities
          </h2>
          <p class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
            Everything developers need. Nothing they don't.
          </p>
        </div>

        <!-- 4 Visual Cards Grid (Full Height Uncropped Screenshots) -->
        <div class="mt-14 grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
          <!-- Card 1: Port Inspector -->
          <div class="flex flex-col justify-between rounded-3xl border border-gray-200/80 bg-gray-50/70 p-6 shadow-sm transition hover:shadow-md hover:border-purple-200">
            <div>
              <div class="flex items-center justify-between">
                <span class="rounded-full bg-purple-100 px-3 py-1 font-mono text-xs font-semibold text-purple-700">
                  Port Intelligence
                </span>
                <span class="font-mono text-xs text-gray-400">:3000, :8000, :5432</span>
              </div>
              <h3 class="mt-4 text-xl font-bold text-gray-900">
                Instant Port & Conflict Killer
              </h3>
              <p class="mt-2 text-sm text-gray-600">
                Never get blocked by <code class="rounded bg-white px-1.5 py-0.5 font-mono text-xs text-red-600 border border-gray-200">EADDRINUSE</code>. Identifies the PID, process name, and Git branch squatting on your port, and kills it with one click.
              </p>
            </div>
            <div class="mt-6 overflow-hidden rounded-2xl border border-gray-200/90 bg-gray-950 p-1 shadow-sm">
              <img 
                src="/screenshots/hero-projects.png" 
                alt="Matric Port Inspector Screenshot" 
                class="w-full h-auto block rounded-xl transition duration-300 hover:scale-[1.01]"
                loading="lazy"
              />
            </div>
          </div>

          <!-- Card 2: Disk & Cache Cleanup -->
          <div class="flex flex-col justify-between rounded-3xl border border-gray-200/80 bg-gray-50/70 p-6 shadow-sm transition hover:shadow-md hover:border-purple-200">
            <div>
              <div class="flex items-center justify-between">
                <span class="rounded-full bg-emerald-100 px-3 py-1 font-mono text-xs font-semibold text-emerald-700">
                  Disk Reclaim
                </span>
                <span class="font-mono text-xs text-emerald-600 font-semibold">37+ GB Cleanable</span>
              </div>
              <h3 class="mt-4 text-xl font-bold text-gray-900">
                Developer Cache & Artifact Purge
              </h3>
              <p class="mt-2 text-sm text-gray-600">
                Reclaim gigabytes instantly. Safely purges stale <code class="font-mono text-xs text-gray-700">node_modules</code>, Xcode <code class="font-mono text-xs text-gray-700">DerivedData</code>, Cargo caches, and Docker dangling images.
              </p>
            </div>
            <div class="mt-6 overflow-hidden rounded-2xl border border-gray-200/90 bg-gray-950 p-1 shadow-sm">
              <img 
                src="/screenshots/cleanup.png" 
                alt="Matric System Cleanup Screenshot" 
                class="w-full h-auto block rounded-xl transition duration-300 hover:scale-[1.01]"
                loading="lazy"
              />
            </div>
          </div>

          <!-- Card 3: Deep Hardware Telemetry -->
          <div class="flex flex-col justify-between rounded-3xl border border-gray-200/80 bg-gray-50/70 p-6 shadow-sm transition hover:shadow-md hover:border-purple-200">
            <div>
              <div class="flex items-center justify-between">
                <span class="rounded-full bg-blue-100 px-3 py-1 font-mono text-xs font-semibold text-blue-700">
                  Apple Silicon Native
                </span>
                <span class="font-mono text-xs text-gray-400">10 Cores · LPDDR5</span>
              </div>
              <h3 class="mt-4 text-xl font-bold text-gray-900">
                Multi-Core CPU & Memory Pressure
              </h3>
              <p class="mt-2 text-sm text-gray-600">
                Real-time Mach VM memory allocation, Apple Silicon per-core distribution, and Darwin BSD network sockets with zero Electron overhead (&lt; 20 MB RAM).
              </p>
            </div>
            <div class="mt-6 overflow-hidden rounded-2xl border border-gray-200/90 bg-gray-950 p-1 shadow-sm">
              <img 
                src="/screenshots/processor.png" 
                alt="Matric Processor Telemetry Screenshot" 
                class="w-full h-auto block rounded-xl transition duration-300 hover:scale-[1.01]"
                loading="lazy"
              />
            </div>
          </div>

          <!-- Card 4: Historical Diagnostics -->
          <div class="flex flex-col justify-between rounded-3xl border border-gray-200/80 bg-gray-50/70 p-6 shadow-sm transition hover:shadow-md hover:border-purple-200">
            <div>
              <div class="flex items-center justify-between">
                <span class="rounded-full bg-amber-100 px-3 py-1 font-mono text-xs font-semibold text-amber-700">
                  Time-Travel
                </span>
                <span class="font-mono text-xs text-gray-400">Local SQLite Ledger</span>
              </div>
              <h3 class="mt-4 text-xl font-bold text-gray-900">
                Long-Term Performance History
              </h3>
              <p class="mt-2 text-sm text-gray-600">
                Did a daemon crash while you stepped away? Scrub backward through high-resolution hardware history to inspect the exact second memory spiked or leaked.
              </p>
            </div>
            <div class="mt-6 overflow-hidden rounded-2xl border border-gray-200/90 bg-gray-950 p-1 shadow-sm">
              <img 
                src="/screenshots/history.png" 
                alt="Matric History Diagnostics Screenshot" 
                class="w-full h-auto block rounded-xl transition duration-300 hover:scale-[1.01]"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Developer Workflow Shortcuts (Tuple Dark Section, Concise & Visual) -->
    <section id="workflow" class="bg-gray-950 px-4 py-20 text-white sm:px-6">
      <div class="mx-auto max-w-5xl">
        <div class="text-center max-w-xl mx-auto">
          <span class="rounded-full bg-green-500/10 border border-green-500/30 px-3 py-1 font-mono text-xs font-semibold text-green-400">
            Tactile Shortcuts
          </span>
          <h2 class="mt-3 text-3xl font-bold sm:text-4xl">
            Stay in flow without touching your mouse
          </h2>
          <p class="mt-2 text-sm text-gray-400">
            Global hotkeys summon Matric from any workspace or editor in milliseconds.
          </p>
        </div>

        <!-- 3 Tactile Cards -->
        <div class="mt-12 grid grid-cols-1 sm:grid-cols-3 gap-6">
          <div class="rounded-2xl border border-gray-800 bg-gray-900/80 p-6 text-center shadow-lg">
            <div class="flex items-center justify-center gap-2">
              <span class="flex h-12 w-12 items-center justify-center rounded-xl border-b-[4px] border-gray-700 bg-gray-800 text-lg font-bold text-white shadow">⌘</span>
              <span class="flex h-12 w-12 items-center justify-center rounded-xl border-b-[4px] border-gray-700 bg-gray-800 text-lg font-bold text-purple-400 shadow">K</span>
            </div>
            <h3 class="mt-4 font-bold text-white text-base">Fuzzy Filter</h3>
            <p class="mt-1 text-xs text-gray-400">Instantly search active ports, processes, or Git branches.</p>
          </div>

          <div class="rounded-2xl border border-gray-800 bg-gray-900/80 p-6 text-center shadow-lg">
            <div class="flex items-center justify-center gap-2">
              <span class="flex h-12 w-12 items-center justify-center rounded-xl border-b-[4px] border-gray-700 bg-gray-800 text-lg font-bold text-white shadow">⌘</span>
              <span class="flex h-12 w-12 items-center justify-center rounded-xl border-b-[4px] border-gray-700 bg-gray-800 text-lg font-bold text-purple-400 shadow">.</span>
            </div>
            <h3 class="mt-4 font-bold text-white text-base">Kill Port</h3>
            <p class="mt-1 text-xs text-gray-400">Instantly terminate the squatted process and free the socket.</p>
          </div>

          <div class="rounded-2xl border border-gray-800 bg-gray-900/80 p-6 text-center shadow-lg">
            <div class="flex items-center justify-center gap-2">
              <span class="flex h-12 w-12 items-center justify-center rounded-xl border-b-[4px] border-gray-700 bg-gray-800 text-lg font-bold text-white shadow">⌘</span>
              <span class="flex h-12 w-12 items-center justify-center rounded-xl border-b-[4px] border-gray-700 bg-gray-800 text-lg font-bold text-white shadow">⇧</span>
              <span class="flex h-12 w-12 items-center justify-center rounded-xl border-b-[4px] border-gray-700 bg-gray-800 text-lg font-bold text-purple-400 shadow">M</span>
            </div>
            <h3 class="mt-4 font-bold text-white text-base">Global Summon</h3>
            <p class="mt-1 text-xs text-gray-400">Bring Matric to the front from Cursor, VS Code, or Terminal.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Side-by-Side Comparison Table (Tuple Style, Crisp & Concise) -->
    <section id="comparison" class="py-20 sm:py-28 bg-white">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <div class="text-center max-w-xl mx-auto">
          <h2 class="font-mono text-xs font-semibold uppercase tracking-widest text-purple-600 sm:text-sm">
            Comparison
          </h2>
          <p class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
            How Matric compares
          </p>
        </div>

        <div class="mt-10 overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="border-b border-gray-200 bg-gray-50 text-xs font-semibold uppercase text-gray-500">
                <th class="py-3.5 px-5">Capability</th>
                <th class="py-3.5 px-5 text-purple-700 font-bold bg-purple-50/50">Matric</th>
                <th class="py-3.5 px-5">macOS Activity Monitor</th>
                <th class="py-3.5 px-5">htop / CLI</th>
