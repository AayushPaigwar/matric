  <!-- Interactive Scripts (Brew copy, View toggle) -->
  <script>
    // Copy Brew Command Script
    const copyBrewBtn = document.getElementById('copyBrewBtn');
    const brewCommand = document.getElementById('brewCommand');
    const copyFeedback = document.getElementById('copyFeedback');

    if (copyBrewBtn && brewCommand && copyFeedback) {
      copyBrewBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('brew install --cask matric');
          const originalHTML = copyFeedback.innerHTML;
          copyFeedback.innerHTML = `<span class="text-green-600 font-semibold text-xs flex items-center gap-1">✔ Copied</span>`;
          setTimeout(() => {
            copyFeedback.innerHTML = originalHTML;
          }, 2000);
        } catch (err) {
          console.error('Failed to copy brew command', err);
        }
      });
    }

    // Window View Switcher Script (Cards vs Table)
    const viewCardsBtn = document.getElementById('viewCardsBtn');
    const viewTableBtn = document.getElementById('viewTableBtn');
    const cardsView = document.getElementById('cardsView');
    const tableView = document.getElementById('tableView');

    if (viewCardsBtn && viewTableBtn && cardsView && tableView) {
      viewCardsBtn.addEventListener('click', () => {
        cardsView.classList.remove('hidden');
        tableView.classList.add('hidden');
        viewCardsBtn.classList.add('bg-white', 'text-gray-900', 'shadow-sm', 'font-semibold');
        viewCardsBtn.classList.remove('hover:text-gray-900');
        viewTableBtn.classList.remove('bg-white', 'text-gray-900', 'shadow-sm', 'font-semibold');
        viewTableBtn.classList.add('hover:text-gray-900');
      });

      viewTableBtn.addEventListener('click', () => {
        tableView.classList.remove('hidden');
        cardsView.classList.add('hidden');
        viewTableBtn.classList.add('bg-white', 'text-gray-900', 'shadow-sm', 'font-semibold');
        viewTableBtn.classList.remove('hover:text-gray-900');
        viewCardsBtn.classList.remove('bg-white', 'text-gray-900', 'shadow-sm', 'font-semibold');
        viewCardsBtn.classList.add('hover:text-gray-900');
      });
    }
  </script>
