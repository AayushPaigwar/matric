---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Global Navigation Header (Tuple Style) -->
  <header class="group/header sticky top-0 z-50 min-h-14 w-full text-sm lg:text-base bg-white/95 backdrop-blur-md border-b border-gray-100 transition-colors">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
      <!-- Logo -->
      <div class="flex items-center gap-8">
        <a class="flex items-center gap-2.5 rounded-lg py-1 font-semibold text-gray-900 transition-opacity hover:opacity-80" href="/">
          <img src="/app-icon.png" alt="Matric App Icon" class="h-8 w-8 rounded-lg shadow-sm" />
          <span class="text-xl font-bold tracking-tight">Matric</span>
          <span class="rounded-full bg-purple-50 border border-purple-200/60 px-2 py-0.5 text-xs font-semibold text-purple-700">v1.0 Beta</span>
        </a>

        <!-- Nav Links -->
        <div class="hidden items-center gap-1 md:flex">
          <a href="#features" class="rounded-lg px-3 py-1.5 text-sm font-medium text-gray-600 transition hover:bg-gray-100 hover:text-gray-900">
            Features
          </a>
          <a href="#ports" class="rounded-lg px-3 py-1.5 text-sm font-medium text-gray-600 transition hover:bg-gray-100 hover:text-gray-900">
            Port Inspector
          </a>
          <a href="#time-travel" class="rounded-lg px-3 py-1.5 text-sm font-medium text-gray-600 transition hover:bg-gray-100 hover:text-gray-900">
            Time-Travel
          </a>
          <a href="#workflow" class="rounded-lg px-3 py-1.5 text-sm font-medium text-gray-600 transition hover:bg-gray-100 hover:text-gray-900">
            Workflow
          </a>
          <a href="#comparison" class="rounded-lg px-3 py-1.5 text-sm font-medium text-gray-600 transition hover:bg-gray-100 hover:text-gray-900">
            Compare
          </a>
          <a href="https://github.com/pawanbhayde/matric" target="_blank" rel="noopener noreferrer" class="rounded-lg px-3 py-1.5 text-sm font-medium text-gray-600 transition hover:bg-gray-100 hover:text-gray-900">
            Docs & Source
          </a>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-3">
        <!-- GitHub Star Link -->
        <a 
          href="https://github.com/pawanbhayde/matric" 
          target="_blank" 
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-3.5 py-1.5 text-sm font-medium text-gray-700 shadow-sm transition hover:bg-gray-50 hover:border-gray-300"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4 fill-gray-700" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          <span>Star</span>
          <span class="rounded-full bg-gray-100 px-1.5 py-0.2 text-xs font-semibold text-gray-600">v1.0</span>
        </a>

        <!-- Download CTA -->
        <a 
          href="https://github.com/pawanbhayde/matric/releases/latest" 
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl bg-purple-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-purple-700 active:scale-[0.98]"
        >
          <svg class="h-4 w-4 fill-white" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 4.87c.66-.82 1.11-1.96.99-3.1-.96.04-2.13.65-2.81 1.45-.6.69-1.12 1.83-.98 2.94 1.07.08 2.15-.55 2.8-1.29z"/>
          </svg>
          <span>Download</span>
        </a>
      </div>
    </nav>
  </header>

  <main class="flex-1">
    <!-- Hero Section (Direct Tuple.app Visual Style) -->
    <section class="relative overflow-hidden pt-12 pb-24 md:pt-16 md:pb-32 bg-gradient-to-b from-gray-50/70 via-white to-white">
      <!-- Background subtle grid pattern -->
      <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:24px_24px] opacity-60 [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>

      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <!-- Floating Announcement Pill (Tuple Pear Style) -->
        <div class="flex justify-center">
          <a 
            href="https://github.com/pawanbhayde/matric/releases" 
            target="_blank"
            class="group inline-flex items-center gap-2 rounded-full border border-green-200/90 bg-green-50/90 px-3.5 py-1.5 text-xs sm:text-sm font-semibold text-green-700 shadow-sm transition hover:bg-green-100 hover:border-green-300"
          >
            <span class="flex h-2 w-2 rounded-full bg-green-500 animate-pulse"></span>
            <span>Matric 1.0 Beta for macOS Sonoma & Sequoia is live</span>
            <span class="text-green-600 transition-transform group-hover:translate-x-0.5">→</span>
          </a>
        </div>

        <!-- Hero Headline & Subtitle -->
        <div class="mt-8 text-center">
          <h1 class="mx-auto max-w-4xl text-4xl font-bold tracking-tight !leading-[1.12] text-gray-900 sm:text-5xl md:text-6xl lg:text-7xl">
            The macOS Activity Monitor <br class="hidden sm:inline" />
            <span class="text-purple-600">reimagined for developers.</span>
          </h1>

          <p class="mx-auto mt-6 max-w-2xl text-lg !leading-relaxed text-gray-500 sm:text-xl font-normal">
            Built from the ground up with native Swift and AppKit. Replaces generic process lists with intelligent project grouping, live developer port monitoring (:3000, :8000), 1-click IDE jump, and 30-day historical time-travel.
          </p>

          <!-- CTA Buttons -->
          <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
            <a 
              href="https://github.com/pawanbhayde/matric/releases/latest" 
              class="flex w-full items-center justify-center gap-3 rounded-xl bg-purple-600 px-8 py-4 text-base font-semibold text-white shadow-lg shadow-purple-600/25 transition hover:bg-purple-700 hover:shadow-purple-600/35 active:scale-[0.98] sm:w-auto"
            >
              <svg class="h-5 w-5 fill-white" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 4.87c.66-.82 1.11-1.96.99-3.1-.96.04-2.13.65-2.81 1.45-.6.69-1.12 1.83-.98 2.94 1.07.08 2.15-.55 2.8-1.29z"/>
              </svg>
              <span>Download for Mac</span>
              <span class="rounded-md bg-purple-700/60 px-2 py-0.5 text-xs font-normal">Universal DMG</span>
            </a>

            <!-- Homebrew Copy Button -->
            <button 
              id="copyBrewBtn" 
              class="group flex w-full items-center justify-between gap-3 rounded-xl border border-gray-200 bg-white px-5 py-4 font-mono text-sm font-medium text-gray-700 shadow-sm transition hover:border-gray-300 hover:bg-gray-50 active:scale-[0.98] sm:w-auto"
              title="Click to copy Homebrew install command"
            >
              <span class="flex items-center gap-2 text-gray-500">
                <span class="text-purple-600 font-bold">$</span>
                <span id="brewCommand" class="text-gray-900 font-medium">brew install --cask matric</span>
              </span>
              <span id="copyFeedback" class="text-gray-400 group-hover:text-gray-600 transition">
                <svg id="copyIcon" class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
                </svg>
              </span>
            </button>
          </div>

          <!-- Trust Badges -->
          <div class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs font-medium text-gray-500">
            <span class="flex items-center gap-1.5">
              <svg class="h-4 w-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
              100% Free & Open Source (MIT)
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="h-4 w-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
              Native Apple Silicon (M1-M4) & Intel
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="h-4 w-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
              Zero Telemetry · 100% Offline & Private
            </span>
          </div>
        </div>

        <!-- Realistic 3D Perspective macOS Window Mockup (Tuple Hero Presentation Style) -->
        <div class="relative mt-14 sm:mt-20">
          <!-- Background Glow -->
          <div class="absolute -top-12 left-1/2 -z-10 h-72 w-3/4 -translate-x-1/2 rounded-full bg-purple-200/40 blur-3xl"></div>

          <!-- macOS Window Container -->
          <div class="overflow-hidden rounded-2xl border border-gray-200/90 bg-white shadow-[0_25px_70px_-15px_rgba(0,0,0,0.12),0_0_0_1px_rgba(0,0,0,0.04)]">
            <!-- Window Titlebar -->
            <div class="flex items-center justify-between border-b border-gray-200 bg-gray-50/90 px-4 py-3 backdrop-blur-sm">
              <div class="flex items-center gap-2">
                <div class="flex gap-1.5">
                  <div class="h-3 w-3 rounded-full bg-[#ff5f57] border border-[#e0443e]"></div>
                  <div class="h-3 w-3 rounded-full bg-[#febc2e] border border-[#d89e24]"></div>
                  <div class="h-3 w-3 rounded-full bg-[#28c840] border border-[#1aab29]"></div>
                </div>
                <div class="ml-4 hidden sm:flex items-center gap-2">
                  <span class="text-xs font-semibold text-gray-700">Matric</span>
                  <span class="rounded bg-gray-200/70 px-1.5 py-0.5 text-[10px] font-medium text-gray-600">Dev Monitor</span>
                </div>
              </div>

              <!-- View Switcher Tabs -->
              <div class="flex items-center rounded-lg bg-gray-200/80 p-0.5 text-xs font-medium text-gray-600">
                <button id="viewCardsBtn" class="flex items-center gap-1.5 rounded-md bg-white px-3 py-1 font-semibold text-gray-900 shadow-sm transition">
                  <svg class="h-3.5 w-3.5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                  <span>Rich Cards</span>
                </button>
                <button id="viewTableBtn" class="flex items-center gap-1.5 rounded-md px-3 py-1 hover:text-gray-900 transition">
                  <svg class="h-3.5 w-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
                  <span>Ports Table</span>
                </button>
              </div>

              <!-- Search Bar & Filters -->
              <div class="hidden md:flex items-center gap-2">
                <div class="relative">
                  <input 
                    type="text" 
                    placeholder="Filter ports, apps, git... (⌘K)" 
                    readonly
                    class="h-7 w-60 rounded-md border border-gray-200 bg-white px-2.5 text-xs text-gray-700 shadow-inner focus:outline-none"
                  />
                  <span class="absolute right-2 top-1.5 text-[10px] text-gray-400 font-mono">⌘K</span>
                </div>
              </div>
            </div>

            <!-- KPI Summary Bar (Feature 1 implementation preview) -->
            <div class="grid grid-cols-2 sm:grid-cols-5 divide-x divide-y sm:divide-y-0 divide-gray-100 border-b border-gray-100 bg-gray-50/50 text-xs">
              <div class="p-3 pl-4">
                <div class="flex items-center justify-between text-gray-400">
                  <span class="font-medium text-gray-500">CPU Usage</span>
                  <span class="font-semibold text-purple-600">14.2%</span>
                </div>
                <div class="mt-1 flex items-baseline gap-1">
                  <span class="font-bold text-gray-900 text-sm">16 Cores</span>
                  <span class="text-[11px] text-gray-500">Apple M3 Max</span>
                </div>
              </div>

              <div class="p-3">
                <div class="flex items-center justify-between text-gray-400">
                  <span class="font-medium text-gray-500">Memory</span>
                  <span class="font-semibold text-blue-600">18.4 GB</span>
                </div>
                <div class="mt-1 flex items-baseline gap-1">
                  <span class="font-bold text-gray-900 text-sm">32 GB Total</span>
                  <span class="text-[11px] text-green-600 font-medium">Pressure: Normal</span>
                </div>
              </div>

              <div class="p-3">
                <div class="flex items-center justify-between text-gray-400">
                  <span class="font-medium text-gray-500">Listening Ports</span>
                  <span class="rounded bg-green-100 px-1.5 py-0.2 font-semibold text-green-700 text-[10px]">8 Active</span>
                </div>
                <div class="mt-1 font-mono text-[11px] text-gray-700 font-semibold truncate">
                  :3000, :8000, :5432, :5173
                </div>
              </div>

              <div class="p-3">
                <div class="flex items-center justify-between text-gray-400">
                  <span class="font-medium text-gray-500">Network I/O</span>
                  <span class="text-gray-400 text-[10px]">Wi-Fi (en0)</span>
                </div>
                <div class="mt-1 font-mono text-[11px] text-gray-800">
                  <span class="text-green-600 font-medium">↓ 4.2 MB/s</span> · <span class="text-blue-600 font-medium">↑ 840 KB/s</span>
                </div>
              </div>

              <div class="p-3 col-span-2 sm:col-span-1">
                <div class="flex items-center justify-between text-gray-400">
                  <span class="font-medium text-gray-500">Disk Free</span>
                  <span class="text-gray-500 text-[10px]">Macintosh HD</span>
                </div>
                <div class="mt-1 flex items-baseline gap-1">
                  <span class="font-bold text-gray-900 text-sm">412 GB</span>
                  <span class="text-[11px] text-gray-500">of 1 TB</span>
                </div>
              </div>
            </div>

            <!-- Main Window Body -->
            <div class="p-4 sm:p-6 bg-white min-h-[380px]">
              <!-- View 1: Rich Cards Mode (Default) -->
              <div id="cardsView" class="space-y-3">
                <!-- Card 1: Next.js Frontend Project -->
                <div class="rounded-xl border border-gray-200/90 bg-white p-4 shadow-sm transition hover:border-purple-300 hover:shadow-md">
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div class="flex items-center gap-3">
                      <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-black text-white font-bold text-sm shadow-sm">
                        N
                      </div>
                      <div>
                        <div class="flex items-center gap-2">
                          <h3 class="font-semibold text-gray-900 text-sm">Next.js E-Commerce Frontend</h3>
                          <span class="rounded bg-green-50 border border-green-200 px-2 py-0.5 font-mono text-xs font-bold text-green-700">
                            :3000
                          </span>
                          <span class="rounded bg-gray-100 px-1.5 py-0.5 font-mono text-[11px] text-gray-500">
                            PID 48291
                          </span>
                        </div>
                        <div class="mt-0.5 flex flex-wrap items-center gap-x-3 text-xs text-gray-500">
                          <span class="flex items-center gap-1 font-mono text-gray-600">
                            📁 ~/Developer/storefront
                          </span>
                          <span class="flex items-center gap-1 font-mono text-purple-700 bg-purple-50 px-1.5 py-0.2 rounded">
                             feature/cart-checkout
                          </span>
                          <span class="text-gray-400">CPU 3.8% · 214 MB RAM · Up 3h 12m</span>
                        </div>
                      </div>
                    </div>

                    <!-- 1-Click Action Buttons -->
                    <div class="flex items-center gap-1.5 self-end sm:self-center">
                      <a 
                        href="http://localhost:3000" 
                        target="_blank" 
                        class="rounded-lg border border-gray-200 bg-gray-50 px-2.5 py-1 text-xs font-medium text-gray-700 hover:bg-gray-100 transition"
                      >
                        Open :3000 ↗
                      </a>
                      <button class="rounded-lg border border-gray-200 bg-gray-50 px-2.5 py-1 text-xs font-medium text-gray-700 hover:bg-gray-100 transition">
                        Cursor
                      </button>
                      <button class="rounded-lg border border-gray-200 bg-gray-50 px-2.5 py-1 text-xs font-medium text-gray-700 hover:bg-gray-100 transition">
                        VS Code
                      </button>
                      <button 
                        onclick="this.closest('.rounded-xl').classList.add('opacity-30', 'line-through'); setTimeout(() => this.innerText = 'Killed', 300)"
                        class="rounded-lg bg-red-50 border border-red-200 px-2.5 py-1 text-xs font-semibold text-red-600 hover:bg-red-100 transition"
                      >
                        Kill Port
                      </button>
                    </div>
                  </div>
                </div>

                <!-- Card 2: Python FastAPI Backend -->
                <div class="rounded-xl border border-gray-200/90 bg-white p-4 shadow-sm transition hover:border-purple-300 hover:shadow-md">
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div class="flex items-center gap-3">
                      <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-600 text-white font-bold text-sm shadow-sm">
                        ⚡
                      </div>
                      <div>
                        <div class="flex items-center gap-2">
                          <h3 class="font-semibold text-gray-900 text-sm">FastAPI Order Processing API</h3>
                          <span class="rounded bg-green-50 border border-green-200 px-2 py-0.5 font-mono text-xs font-bold text-green-700">
                            :8000
                          </span>
                          <span class="rounded bg-gray-100 px-1.5 py-0.5 font-mono text-[11px] text-gray-500">
                            PID 51204
                          </span>
                        </div>
                        <div class="mt-0.5 flex flex-wrap items-center gap-x-3 text-xs text-gray-500">
                          <span class="flex items-center gap-1 font-mono text-gray-600">
                            📁 ~/Developer/services/orders-api
                          </span>
                          <span class="flex items-center gap-1 font-mono text-purple-700 bg-purple-50 px-1.5 py-0.2 rounded">
                             main
                          </span>
                          <span class="text-gray-400">CPU 1.2% · 88 MB RAM · Healthy</span>
                        </div>
                      </div>
                    </div>

                    <div class="flex items-center gap-1.5 self-end sm:self-center">
                      <a href="http://localhost:8000/docs" target="_blank" class="rounded-lg border border-gray-200 bg-gray-50 px-2.5 py-1 text-xs font-medium text-gray-700 hover:bg-gray-100 transition">
                        Swagger ↗
                      </a>
                      <button class="rounded-lg border border-gray-200 bg-gray-50 px-2.5 py-1 text-xs font-medium text-gray-700 hover:bg-gray-100 transition">
                        Cursor
                      </button>
                      <button class="rounded-lg bg-red-50 border border-red-200 px-2.5 py-1 text-xs font-semibold text-red-600 hover:bg-red-100 transition">
                        Kill Port
                      </button>
                    </div>
                  </div>
                </div>

                <!-- Card 3: Intelligent Grouping Row (Collapsed Chrome Helpers) -->
                <div class="rounded-xl border border-gray-200/90 bg-gray-50/70 p-3.5 shadow-sm">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                      <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-500 text-white font-bold text-xs shadow-sm">
                        🌐
                      </div>
                      <div>
                        <div class="flex items-center gap-2">
                          <span class="font-semibold text-gray-800 text-xs">Google Chrome</span>
