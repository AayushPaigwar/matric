  <!-- Interactive Screenshot Switcher Script -->
  <script>
    const tabs = document.querySelectorAll('.shot-tab');
    const mainImg = document.getElementById('mainScreenshot');
    const labelSpan = document.getElementById('currentShotLabel');

    if (tabs && mainImg) {
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const shotSrc = tab.getAttribute('data-shot');
          const shotLabel = tab.getAttribute('data-label');
          if (!shotSrc) return;

          // Update active tab styles
          tabs.forEach((t) => {
            t.classList.remove('bg-purple-600', 'text-white', 'font-semibold', 'shadow-sm');
            t.classList.add('text-gray-400');
          });
          tab.classList.add('bg-purple-600', 'text-white', 'font-semibold', 'shadow-sm');
          tab.classList.remove('text-gray-400');

          // Smooth image transition
          mainImg.classList.add('opacity-40');
          setTimeout(() => {
            (mainImg as HTMLImageElement).src = shotSrc;
            mainImg.classList.remove('opacity-40');
          }, 150);

          if (labelSpan && shotLabel) {
            labelSpan.textContent = shotLabel;
          }
        });
      });
    }
  </script>
