<script>
	// 1. Dual-View Mode Switcher (Cards vs Ports Table)
	const toggleCards = document.getElementById('toggle-cards');
	const toggleTable = document.getElementById('toggle-table');
	const viewCards = document.getElementById('view-cards-content');
	const viewTable = document.getElementById('view-table-content');

	toggleCards?.addEventListener('click', () => {
		toggleCards.classList.add('active');
		toggleTable?.classList.remove('active');
		viewCards?.classList.remove('hidden');
		viewTable?.classList.add('hidden');
	});

	toggleTable?.addEventListener('click', () => {
		toggleTable.classList.add('active');
		toggleCards?.classList.remove('active');
		viewTable?.classList.remove('hidden');
		viewCards?.classList.add('hidden');
	});

	// 2. Terminal Command Copy Button
	const copyBtn = document.getElementById('copy-btn');
	const copyLabel = document.getElementById('copy-label');
	const brewCmd = document.getElementById('brew-cmd');
	const toast = document.getElementById('toast');

	function showToast(msg: string) {
		if (!toast) return;
		toast.textContent = msg;
		toast.classList.add('show');
		setTimeout(() => {
			toast.classList.remove('show');
		}, 2400);
	}

	copyBtn?.addEventListener('click', () => {
		if (brewCmd) {
			navigator.clipboard.writeText(brewCmd.textContent || '');
			if (copyLabel) copyLabel.textContent = 'Copied!';
			showToast('Command copied to clipboard!');
			setTimeout(() => {
				if (copyLabel) copyLabel.textContent = 'Copy';
			}, 2000);
		}
	});

	// 3. Port Watchdog Interactive Modal
	const btnWatchdogModal = document.getElementById('btn-watchdog-modal');
	const watchdogModal = document.getElementById('watchdog-modal');
	const btnCloseModal = document.getElementById('btn-close-modal');
	const watchdogInput = document.getElementById('watchdog-input') as HTMLInputElement;
	const btnSimulateScan = document.getElementById('btn-simulate-scan');
	const btnSimulateKill = document.getElementById('btn-simulate-kill');
	const resultOccupied = document.getElementById('watchdog-result-occupied');
	const resultFree = document.getElementById('watchdog-result-free');
	const presetChips = document.querySelectorAll('.preset-chip');

	btnWatchdogModal?.addEventListener('click', () => {
		watchdogModal?.classList.remove('hidden');
	});

	btnCloseModal?.addEventListener('click', () => {
		watchdogModal?.classList.add('hidden');
	});

	watchdogModal?.addEventListener('click', (e) => {
		if (e.target === watchdogModal) {
			watchdogModal.classList.add('hidden');
		}
	});

	presetChips.forEach(chip => {
		chip.addEventListener('click', () => {
			presetChips.forEach(c => c.classList.remove('active'));
			chip.classList.add('active');
			const port = chip.getAttribute('data-port') || '3000';
			if (watchdogInput) watchdogInput.value = port;
			simulateScan(port);
		});
	});

	btnSimulateScan?.addEventListener('click', () => {
		const port = watchdogInput?.value.replace(':', '') || '3000';
		simulateScan(port);
	});

	function simulateScan(port: string) {
		if (port === '8080' || port === '3306') {
			resultOccupied?.classList.add('hidden');
			resultFree?.classList.remove('hidden');
		} else {
			resultOccupied?.classList.remove('hidden');
			resultFree?.classList.add('hidden');
		}
	}

	btnSimulateKill?.addEventListener('click', () => {
		resultOccupied?.classList.add('hidden');
		resultFree?.classList.remove('hidden');
		showToast(`Process holding port killed! Port is now free.`);
	});
</script>

