---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<!-- Ambient Background Glows -->
	<div class="glow-bg-top" aria-hidden="true"></div>
	<div class="glow-bg-middle" aria-hidden="true"></div>

	<!-- Navigation Bar -->
	<header class="nav-header">
		<div class="nav-container">
			<a href="#" class="brand-link">
				<img src="/app-icon.png" alt="Matric Logo" class="brand-icon" />
				<span class="brand-name">Matric</span>
				<span class="brand-badge">v1.0-beta</span>
			</a>

			<nav class="nav-links">
				<a href="#projects">Dev Projects</a>
				<a href="#comparison">App Grouping</a>
				<a href="#time-travel">Time-Travel</a>
				<a href="#sensors">Sensors</a>
				<a href="#storage">Storage & Cleaner</a>
				<a href="#architecture">Architecture</a>
			</nav>

			<div class="nav-actions">
				<a href="https://github.com/pawanbhayde/matric" target="_blank" rel="noopener noreferrer" class="btn-github">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
						<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
					</svg>
					<span>Star on GitHub</span>
				</a>
				<a href="#download" class="btn-download-nav">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
						<path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.76 1.05-1.82.93-2.88-.91.04-2.03.61-2.68 1.37-.58.67-1.09 1.76-.95 2.8 1.02.08 2.08-.53 2.7-1.29z"/>
					</svg>
					<span>Download App</span>
				</a>
			</div>
		</div>
	</header>

	<!-- Hero Section -->
	<section class="hero-section">
		<div class="hero-content">
			<div class="hero-badge">
				<span class="pulse-radar"></span>
				<span class="badge-text">OPEN SOURCE · NATIVE MACOS 14+ & 15+</span>
			</div>

			<h1 class="hero-title">
				The macOS Activity Monitor <br>
				<span class="gradient-text">reimagined for developers.</span>
			</h1>

			<p class="hero-subtitle">
				Stop drowning in hundreds of anonymous helper daemons. Matric brings intelligent app grouping, live developer port inspection, 30-day historical time-travel, and instant bottleneck diagnostics into a blazing-fast native interface — 100% locally and privately.
			</p>

			<div class="hero-cta-group">
				<a href="https://github.com/pawanbhayde/matric/releases" class="btn-primary-large">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
						<path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.76 1.05-1.82.93-2.88-.91.04-2.03.61-2.68 1.37-.58.67-1.09 1.76-.95 2.8 1.02.08 2.08-.53 2.7-1.29z"/>
					</svg>
					<span>Download for Mac (Apple Silicon & Intel)</span>
				</a>

				<a href="https://github.com/pawanbhayde/matric" target="_blank" rel="noopener noreferrer" class="btn-secondary-large">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
						<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
					</svg>
					<span>View Source Code</span>
				</a>
			</div>

			<!-- Terminal Install Strip -->
			<div class="hero-terminal-strip">
				<span class="terminal-prompt">$</span>
				<code id="brew-cmd">git clone https://github.com/pawanbhayde/matric.git && cd matric</code>
				<button id="copy-btn" class="btn-copy-code" title="Copy to clipboard">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
						<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
					</svg>
					<span id="copy-label">Copy</span>
				</button>
			</div>

			<!-- Quick specs pill row -->
			<div class="hero-specs-row">
				<div class="spec-item">
					<span class="spec-icon">⚡</span>
					<span>Pure Swift & SwiftUI</span>
				</div>
				<div class="spec-divider"></div>
				<div class="spec-item">
					<span class="spec-icon">🔒</span>
					<span>Zero Outbound Telemetry</span>
				</div>
				<div class="spec-divider"></div>
				<div class="spec-item">
					<span class="spec-icon">⏱️</span>
					<span>30-Day Offline SQLite Storage</span>
				</div>
				<div class="spec-divider"></div>
				<div class="spec-item">
					<span class="spec-icon">🍃</span>
					<span>&lt; 1% CPU Polling Footprint</span>
				</div>
			</div>
		</div>

		<!-- Interactive Hero Window Showcase -->
		<div class="app-window-frame">
			<div class="window-header">
				<div class="window-traffic-lights">
					<span class="light close"></span>
					<span class="light minimize"></span>
					<span class="light expand"></span>
				</div>

				<div class="window-titlebar">
					<span class="window-app-name">Matric — Developer Projects</span>
					<span class="window-path-pill">Listening Ports & Local Runtimes</span>
				</div>

				<div class="window-toolbar-actions">
					<div class="interactive-view-toggle">
						<button id="toggle-cards" class="view-btn active" data-view="cards">
							<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
								<rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
								<rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
								<rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
								<rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
							</svg>
							<span>Cards</span>
						</button>
						<button id="toggle-table" class="view-btn" data-view="table">
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<rect x="3" y="3" width="18" height="18" rx="2"></rect>
								<path d="M3 9h18M3 15h18M9 3v18"></path>
							</svg>
							<span>Ports Table</span>
						</button>
					</div>

					<button id="btn-watchdog-modal" class="btn-check-port">
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<circle cx="12" cy="12" r="10"></circle>
							<path d="m9 12 2 2 4-4"></path>
						</svg>
						<span>Check Port...</span>
					</button>
				</div>
			</div>

			<!-- Window Interior Body -->
			<div class="window-body">
				<!-- KPI Bar -->
				<div class="kpi-summary-bar">
					<div class="kpi-card">
						<div class="kpi-card-header">
							<span class="kpi-icon emerald">⚡</span>
							<span class="kpi-title">ACTIVE SERVICES</span>
						</div>
						<div class="kpi-value-row">
							<span class="kpi-value">5</span>
							<span class="kpi-badge emerald">Online</span>
						</div>
						<span class="kpi-caption">Vite, Next, Python, Postgres, Redis</span>
					</div>

					<div class="kpi-card">
						<div class="kpi-card-header">
							<span class="kpi-icon cyan">🌐</span>
							<span class="kpi-title">OPEN TCP PORTS</span>
						</div>
						<div class="kpi-value-row">
							<span class="kpi-value">5</span>
							<span class="kpi-badge cyan">Bound</span>
						</div>
						<span class="kpi-caption">:3000, :5173, :8000, :5432, :6379</span>
					</div>

					<div class="kpi-card">
						<div class="kpi-card-header">
							<span class="kpi-icon indigo">💾</span>
							<span class="kpi-title">DEV MEMORY</span>
						</div>
						<div class="kpi-value-row">
							<span class="kpi-value">1.12 GB</span>
							<span class="kpi-badge muted">Combined</span>
						</div>
						<span class="kpi-caption">7.0% of physical system RAM</span>
					</div>

					<div class="kpi-card">
						<div class="kpi-card-header">
							<span class="kpi-icon amber">🔥</span>
							<span class="kpi-title">DEV CPU LOAD</span>
						</div>
						<div class="kpi-value-row">
							<span class="kpi-value">2.8%</span>
							<span class="kpi-badge emerald">Low Load</span>
						</div>
						<span class="kpi-caption">Idle dev watchers running smoothly</span>
					</div>
				</div>

				<!-- Dual View Dynamic Container -->
				<div class="views-wrapper">
					<!-- CARDS VIEW -->
					<div id="view-cards-content" class="cards-view-grid">
						<!-- Next.js Card -->
						<div class="project-card">
							<div class="card-top-row">
								<div class="project-identity">
									<div class="runtime-badge nextjs">
										<span>▲</span>
									</div>
									<div class="project-naming">
										<div class="name-status-row">
											<h4 class="project-title">matric-web</h4>
											<span class="status-pill online">
												<span class="status-pulse-dot"></span>
												ONLINE
											</span>
										</div>
										<div class="path-branch-row">
											<span class="git-branch-tag">⎇ main</span>
											<span class="project-path-text">~/projects/matric-web</span>
										</div>
									</div>
								</div>
								<div class="runtime-stats">
									<span class="stat-pill">1.2% CPU</span>
									<span class="stat-pill">412 MB</span>
								</div>
							</div>

							<div class="card-ports-row">
								<span class="port-label">PORTS:</span>
								<a href="http://localhost:3000" target="_blank" class="port-chip link">
									<span class="port-dot"></span>
									<span>:3000</span>
									<span class="port-arrow">↗</span>
								</a>
							</div>

							<div class="card-action-bar">
								<div class="ide-launchers">
									<button class="btn-ide" title="Open in Cursor">Cursor</button>
									<button class="btn-ide" title="Open in VS Code">VS Code</button>
									<button class="btn-ide" title="Open in Terminal">Terminal</button>
									<button class="btn-ide" title="Reveal in Finder">Finder</button>
								</div>
								<button class="btn-stop-port">Stop</button>
							</div>
						</div>

						<!-- Vite Card -->
						<div class="project-card">
							<div class="card-top-row">
								<div class="project-identity">
									<div class="runtime-badge vite">
										<span>⚡</span>
									</div>
									<div class="project-naming">
										<div class="name-status-row">
											<h4 class="project-title">landing-page</h4>
											<span class="status-pill online">
												<span class="status-pulse-dot"></span>
												ONLINE
											</span>
										</div>
										<div class="path-branch-row">
											<span class="git-branch-tag">⎇ feat/v1</span>
											<span class="project-path-text">~/projects/matric/landing-page</span>
										</div>
									</div>
								</div>
								<div class="runtime-stats">
									<span class="stat-pill">0.4% CPU</span>
									<span class="stat-pill">186 MB</span>
								</div>
							</div>

							<div class="card-ports-row">
								<span class="port-label">PORTS:</span>
								<a href="http://localhost:5173" target="_blank" class="port-chip link">
									<span class="port-dot"></span>
									<span>:5173</span>
									<span class="port-arrow">↗</span>
								</a>
							</div>

							<div class="card-action-bar">
								<div class="ide-launchers">
									<button class="btn-ide">Cursor</button>
									<button class="btn-ide">VS Code</button>
									<button class="btn-ide">Terminal</button>
								</div>
								<button class="btn-stop-port">Stop</button>
							</div>
						</div>

						<!-- FastAPI Card -->
						<div class="project-card">
							<div class="card-top-row">
								<div class="project-identity">
									<div class="runtime-badge python">
										<span>🐍</span>
									</div>
									<div class="project-naming">
										<div class="name-status-row">
											<h4 class="project-title">telemetry-api</h4>
											<span class="status-pill online">
												<span class="status-pulse-dot"></span>
												ONLINE
											</span>
										</div>
										<div class="path-branch-row">
											<span class="git-branch-tag">⎇ staging</span>
											<span class="project-path-text">~/services/telemetry-api</span>
										</div>
									</div>
								</div>
								<div class="runtime-stats">
									<span class="stat-pill">0.8% CPU</span>
									<span class="stat-pill">145 MB</span>
								</div>
							</div>

							<div class="card-ports-row">
								<span class="port-label">PORTS:</span>
								<a href="http://localhost:8000" target="_blank" class="port-chip link">
									<span class="port-dot"></span>
									<span>:8000</span>
									<span class="port-arrow">↗</span>
								</a>
							</div>

							<div class="card-action-bar">
								<div class="ide-launchers">
									<button class="btn-ide">Cursor</button>
									<button class="btn-ide">Terminal</button>
								</div>
								<button class="btn-stop-port">Stop</button>
							</div>
						</div>

						<!-- PostgreSQL Card -->
						<div class="project-card">
							<div class="card-top-row">
								<div class="project-identity">
									<div class="runtime-badge postgres">
										<span>🐘</span>
									</div>
									<div class="project-naming">
										<div class="name-status-row">
											<h4 class="project-title">postgres-local</h4>
											<span class="status-pill online">
												<span class="status-pulse-dot"></span>
												ONLINE
											</span>
										</div>
										<div class="path-branch-row">
											<span class="project-path-text">/opt/homebrew/var/postgresql@16</span>
										</div>
									</div>
								</div>
								<div class="runtime-stats">
									<span class="stat-pill">0.2% CPU</span>
									<span class="stat-pill">318 MB</span>
								</div>
							</div>

							<div class="card-ports-row">
								<span class="port-label">PORTS:</span>
								<span class="port-chip db">
									<span class="port-dot"></span>
									<span>:5432</span>
								</span>
							</div>

							<div class="card-action-bar">
								<div class="ide-launchers">
									<button class="btn-ide">Terminal</button>
									<button class="btn-ide">Finder</button>
								</div>
								<button class="btn-stop-port">Stop</button>
							</div>
						</div>
					</div>

					<!-- PORTS TABLE VIEW (Hidden by default) -->
					<div id="view-table-content" class="ports-table-container hidden">
						<table class="ports-table">
							<thead>
								<tr>
									<th>PORT</th>
									<th>SOCKET</th>
									<th>SERVICE / RUNTIME</th>
									<th>PROJECT & PATH</th>
									<th>PID</th>
									<th>CPU</th>
									<th>RAM</th>
									<th>ACTIONS</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td><span class="table-port-chip">:3000</span></td>
									<td><span class="table-status-listen"><span class="table-socket-dot"></span>LISTEN</span></td>
									<td><span class="table-runtime-badge nextjs">▲ Next.js</span></td>
									<td>
										<div class="table-project-cell">
											<span class="table-proj-name">matric-web</span>
											<span class="table-branch-pill">⎇ main</span>
										</div>
									</td>
									<td><code class="table-pid">32941</code></td>
									<td><span class="table-cpu">1.2%</span></td>
									<td><span class="table-ram">412 MB</span></td>
									<td>
										<div class="table-action-btns">
											<button class="table-btn-browser" title="Open localhost:3000">Open</button>
											<button class="table-btn-kill" title="Stop process">Kill</button>
										</div>
									</td>
								</tr>

								<tr>
									<td><span class="table-port-chip">:5173</span></td>
									<td><span class="table-status-listen"><span class="table-socket-dot"></span>LISTEN</span></td>
									<td><span class="table-runtime-badge vite">⚡ Vite</span></td>
									<td>
										<div class="table-project-cell">
											<span class="table-proj-name">landing-page</span>
											<span class="table-branch-pill">⎇ feat/v1</span>
										</div>
									</td>
									<td><code class="table-pid">33104</code></td>
									<td><span class="table-cpu">0.4%</span></td>
									<td><span class="table-ram">186 MB</span></td>
									<td>
										<div class="table-action-btns">
											<button class="table-btn-browser">Open</button>
											<button class="table-btn-kill">Kill</button>
										</div>
									</td>
								</tr>

								<tr>
									<td><span class="table-port-chip">:8000</span></td>
									<td><span class="table-status-listen"><span class="table-socket-dot"></span>LISTEN</span></td>
									<td><span class="table-runtime-badge python">🐍 Python / FastAPI</span></td>
									<td>
										<div class="table-project-cell">
											<span class="table-proj-name">telemetry-api</span>
											<span class="table-branch-pill">⎇ staging</span>
										</div>
									</td>
									<td><code class="table-pid">31802</code></td>
									<td><span class="table-cpu">0.8%</span></td>
									<td><span class="table-ram">145 MB</span></td>
									<td>
										<div class="table-action-btns">
											<button class="table-btn-browser">Open</button>
											<button class="table-btn-kill">Kill</button>
										</div>
									</td>
								</tr>

								<tr>
									<td><span class="table-port-chip">:5432</span></td>
									<td><span class="table-status-listen"><span class="table-socket-dot"></span>LISTEN</span></td>
									<td><span class="table-runtime-badge postgres">🐘 PostgreSQL</span></td>
									<td>
										<div class="table-project-cell">
											<span class="table-proj-name">postgres-local</span>
										</div>
									</td>
									<td><code class="table-pid">1042</code></td>
									<td><span class="table-cpu">0.2%</span></td>
									<td><span class="table-ram">318 MB</span></td>
									<td>
										<div class="table-action-btns">
											<button class="table-btn-browser">Open</button>
											<button class="table-btn-kill">Kill</button>
										</div>
									</td>
